[Unit]
Description=SnapHost Ephemeral & Permanent Cloud Previews
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/snaphost
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

# Resource Limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
