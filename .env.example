# ==========================================
# SnapHost Production Konfiguration (.env)
# ==========================================

# Port und Host des SnapHost Servers (hinter Nginx / NPM)
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Deine Basis-Domain (wo die Apps als Subdomains laufen)
# Beispiel: apps.meinedomain.de (oder direkt meinedomain.de)
ROOT_DOMAIN=apps.meinedomain.de

# Subdomain für das Admin-Dashboard (z. B. admin -> admin.apps.meinedomain.de)
ADMIN_SUBDOMAIN=admin

# Dein sicheres Master-Passwort für den Dashboard-Login
ADMIN_PASSWORD=SetzeHierEinSehrSicheresPasswort

# Geheimer Schlüssel für JWT-Tokens (beliebige lange, zufällige Zeichenkette)
JWT_SECRET=super-geheimer-zufalls-schluessel-mindestens-32-zeichen-lang

# Datenverzeichnis für SQLite-Datenbank und statische App-Dateien
DATA_DIR=./data

# Standard-Ablaufzeit für neue Deployments (z. B. 2h, 24h, 7d oder permanent)
DEFAULT_TTL=24h

# Janitor Aufräumintervall in Millisekunden (Standard: 60000 = 1 Minute)
CLEANUP_INTERVAL_MS=60000

# Maximales Upload-Limit für ZIP-Archive in Megabyte
MAX_UPLOAD_SIZE_MB=250

# Docker Einstellungen (für interaktive Container & Node.js Server)
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_MEMORY_LIMIT_MB=512
